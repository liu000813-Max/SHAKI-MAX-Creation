node_modules/
.next/
.next_*/
.next_stale_*/
.next_build_*/
out/
# Stale build caches moved aside (the sandbox blocks deleting .next; we rename it instead).
_build_trash/
# Slim static-export copy used only for WorkBuddy Sites deploy (videos dropped to fit bundle limit).
# Regenerable via `node assemble-out.mjs` from .next after `next build`. Keep it out of git.
deploy_out/

# OS / editor
.DS_Store
Thumbs.db
*.log

# --- Phase 01 ingestion pipeline: regenerable runtime artifacts ---
# data/ is reproducible via `python cli.py import --fixtures` + `export`.
# .gitkeep files are kept so the dir tree survives in the repo.
data/raw/*
data/processed/*
data/products/*
!data/**/.gitkeep

# Phase 01 POC runtime artifacts (regenerable via poc_discover.py / poc_process.py)
scripts/product-ingestion/poc_output/*

# Python
__pycache__/
*.pyc
.env
.env.local

# --- Heydildi real product library: large media binaries stay local only ---
# The 1.2GB of images/videos/CAD extracted from the Heydildi export lives under
# apps/web/public/products/heydildi and is NOT committed (GitHub rejects >100MB,
# and adult media is an AUP risk). The committed source-of-truth index is
# apps/web/lib/data/heydildi-catalog.json (SKU -> media URLs manifest).
apps/web/public/products/heydildi/

# TypeScript build info
*.tsbuildinfo

# generated by the verification harness, never source
scripts/.mobile-fixture.json
scripts/.recall-*.json

# browser smoke leftovers
scripts/downloads/
downloads/
exported-analysis.json
scripts/.ai-enriched-*.json
scripts/.en-products-*.json

# --- Crawl artefacts (2026-10-10) ---
# Both are dot-files on purpose: local caches, regenerable, and far too large for a repo.
#   scripts/.en-catalog-raw.json <- scripts/_build_full_catalog.mjs  (~1.6 MB, the crawled pages)
#   scripts/.en-images.json      <- scripts/_map_en_images.mjs       (~120 KB, id -> photo map)
# The catalogue itself (apps/web/lib/data/products.ts) is generated from the first of those by
# scripts/_gen_products.ts and IS tracked, so a clone can build without re-crawling.
scripts/.en-catalog-raw.json
scripts/.en-images.json
