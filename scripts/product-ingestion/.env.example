# ============================================================================
# SHAKI Product Ingestion — environment configuration
# Copy this file to `.env` and fill in. NEVER commit real secrets.
# ============================================================================

# --- Crawl target (REQUIRED for live mode) ---
# Do NOT hardcode the website in code. Set it here.
SHAKI_WEBSITE_URL=https://YOUR-SHAKI-WEBSITE.com

# --- Rate limiting / politeness ---
REQUEST_DELAY=1.5
CONCURRENCY=2
REQUEST_TIMEOUT=30
MAX_RETRIES=3
USER_AGENT=SHAKIProductBot/1.0 (+https://shaki.com; product-intel)

# --- Database ---
# Local dev (default, zero-install SQLite):
#   sqlite:///D:/workbuddy_outputs/shaki-ai-product-match/data/processed/shaki_product_intelligence.db
# Production (Postgres + Prisma, see ../../prisma/schema.prisma):
#   DATABASE_URL=postgresql://user:pass@host:5432/shaki_product_intel
DATABASE_URL=

# --- AI enrichment ---
# Provider: heuristic | openai | doubao
#   heuristic -> deterministic, NO API key needed (fills only derivable AI fields)
#   openai   -> OpenAI-compatible chat completions
#   doubao   -> 豆包 is OpenAI-compatible; set AI_BASE_URL accordingly
AI_PROVIDER=heuristic
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2

# --- Thresholds ---
DATA_COMPLETENESS_MIN=75
