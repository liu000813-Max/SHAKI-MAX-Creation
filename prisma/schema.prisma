// SHAKI AI Product Match — Phase 01 Product Intelligence store
// Prisma / PostgreSQL production schema (mirrors spec section 16/17).
//
// Local dev uses the zero-install SQLite backend in scripts/product-ingestion/db.py.
// This Prisma schema is the PRODUCTION target: swap DATABASE_URL to a postgresql://
// connection and run `prisma migrate dev` / `prisma generate`.
//
// The 228-field Product Master dictionary is the SINGLE SOURCE OF TRUTH and lives in
// code (scripts/product-ingestion/product_master.py :: FIELD_ORDER), NOT in raw SQL
// columns — keeping the schema stable while the dictionary evolves. The 228 fields are
// stored in the `fields` JSONB column on `Product` (GIN-indexed for queryability). The
// SQLite backend keeps them as flat TEXT columns for the same effect.
//
// Column naming convention: snake_case here <=> field_id (snake_case) in FIELD_ORDER.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  productId           String   @id @map("product_id")
  sku                 String?  @map("sku")
  canonicalUrl        String?  @map("canonical_url")
  contentHash         String?  @map("content_hash")
  productVersion      Int      @default(1) @map("product_version")

  // --- structured, frequently-queried columns (subset of the 228, indexed) ---
  primaryCategory     String?  @map("primary_category") // LOCKED: Female|Male|Couples|BDSM|Water-Based
  productStatus       String   @default("Draft") @map("product_status")
  productNameCn       String?  @map("product_name_cn")
  productNameEn       String?  @map("product_name_en")
  seriesName          String?  @map("series_name")
  launchDate          String?  @map("launch_date")

  // --- the full 228-field Product Master dictionary (enumerated in product_master.py) ---
  fields              Json     @default("{}")

  // --- provenance: per-field { source_type, source_reference, confidence, last_verified } ---
  provenance          Json     @default("{}")

  // --- pipeline-derived flags (spec section 18/19/20) ---
  dataCompleteness    Int      @default(0) @map("data_completeness")
  recommendationEligible Boolean @default(false) @map("recommendation_eligible")
  needsReview         Boolean  @default(true) @map("needs_review")
  complianceVerified  Boolean  @default(false) @map("compliance_verified")

  productIntelligenceScore Int  @default(0) @map("product_intelligence_score")
  productPriorityScore Int     @default(0) @map("product_priority_score")

  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  sources             ProductSource[]
  media              ProductMedia[]
  tags               ProductTag[]
  scores             ProductScore[]
  relationsOut       ProductRelation[] @relation("ProductRelationsOut")
  relationsIn        ProductRelation[] @relation("ProductRelationsIn")
  history            ProductHistory[]

  @@unique([sku])
  @@index([primaryCategory])
  @@index([productStatus])
  @@index([recommendationEligible])
  @@map("products")
}

model ProductHistory {
  historyId      Int      @id @default(autoincrement()) @map("history_id")
  productId      String   @map("product_id")
  productVersion Int      @map("product_version")
  fieldsJson     Json     @map("fields_json")
  provenanceJson Json     @map("provenance_json")
  savedAt        DateTime @default(now()) @map("saved_at")

  product Product @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@map("products_history")
}

model ProductSource {
  productSourceId Int      @id @default(autoincrement()) @map("product_source_id")
  productId       String   @map("product_id")
  sourceUrl       String   @map("source_url")
  sourceType      String   @default("official") @map("source_type") // official|catalog|sales_input|ai_inference
  rawContent      String   @db.Text @map("raw_content")
  scrapedAt       DateTime @default(now()) @map("scraped_at")
  contentHash     String   @map("content_hash")

  product Product @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@map("product_sources")
}

model ProductMedia {
  mediaId          Int      @id @default(autoincrement()) @map("media_id")
  productId        String   @map("product_id")
  url              String
  role             String   @default("OTHER") // HERO|FRONT|SIDE|DETAIL|PACKAGING|LIFESTYLE|FEATURE|SIZE|INSTRUCTION|OTHER
  originalUrl      String?  @map("original_url")
  width            Int?
  height           Int?
  mimeType         String?  @map("mime_type")
  fileSize         Int?     @map("file_size")
  aiClassifiedRole String?  @map("ai_classified_role")
  fetched          Boolean  @default(false)

  product Product @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@index([productId])
  @@map("product_media")
}

model ProductTag {
  tagId        Int      @id @default(autoincrement()) @map("tag_id")
  productId    String   @map("product_id")
  tagGroup     String   @map("tag_group")   // e.g. primary_category / functional_tags / audience_tags
  tagValue     String   @map("tag_value")
  sourceType   String   @map("source_type")
  confidence   Float    @default(0.5)

  product Product @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@index([productId, tagGroup])
  @@map("product_tags")
}

model ProductScore {
  scoreId     Int      @id @default(autoincrement()) @map("score_id")
  productId   String   @map("product_id")
  scoreName   String   @map("score_name") // product_intelligence_score / product_priority_score / phase-2 scores
  value       Float
  sourceType  String   @map("source_type")
  computedAt  DateTime @default(now()) @map("computed_at")

  product Product @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@index([productId, scoreName])
  @@map("product_scores")
}

model ProductRelation {
  relationId         Int      @id @default(autoincrement()) @map("relation_id")
  productId          String   @map("product_id")
  relatedProductId   String   @map("related_product_id")
  relationType       String   @map("relation_type") // complement|substitute|bundle|accessory
  sourceType         String   @map("source_type")

  product   Product @relation("ProductRelationsOut", fields: [productId], references: [productId], onDelete: Cascade)
  related   Product @relation("ProductRelationsIn", fields: [relatedProductId], references: [productId], onDelete: Cascade)

  @@map("product_relations")
}

model ProductImportJob {
  jobId             Int      @id @default(autoincrement()) @map("job_id")
  startTime         DateTime @default(now()) @map("start_time")
  endTime           DateTime? @map("end_time")
  sourceUrl         String   @map("source_url")
  productsDiscovered Int     @default(0) @map("products_discovered")
  productsCreated   Int      @default(0) @map("products_created")
  productsUpdated   Int      @default(0) @map("products_updated")
  productsSkipped   Int      @default(0) @map("products_skipped")
  productsFailed    Int      @default(0) @map("products_failed")
  errors            String?  @db.Text

  errors_log        ProductImportError[]

  @@map("product_import_jobs")
}

model ProductImportError {
  errorId      Int      @id @default(autoincrement()) @map("error_id")
  jobId        Int      @map("job_id")
  url          String
  errorType    String   @map("error_type")
  errorMessage String   @map("error_message")
  retryCount   Int      @default(0) @map("retry_count")

  job ProductImportJob @relation(fields: [jobId], references: [jobId], onDelete: Cascade)

  @@map("product_import_errors")
}
